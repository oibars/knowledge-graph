# Knowledge Graph configuration
# Copy to .env and fill in the values you need.

# Override the default SQLite + snapshot location
# KG_DATA_DIR=~/.knowledge-graph/data

# Local Ollama inference (used by agent indexing and the optional SemanticLinker).
# Bookmark/save scoring needs no LLM; these only matter if you run those features.
# Defaults shown — uncomment to override.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_CHAT_MODEL=gemma4:e4b

# Reddit (script app from https://www.reddit.com/prefs/apps, redirect_uri http://localhost:8080)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=knowledge-graph/1.0 by <username>

# Reddit auth, preferred path (no Reddit password needed, works with Google SSO accounts)
# Get this once with: python scripts/reddit_oauth_setup.py
REDDIT_REFRESH_TOKEN=

# Reddit auth, fallback (only if your account has a Reddit-native password)
# REDDIT_USERNAME=
# REDDIT_PASSWORD=

# YouTube (download an OAuth Desktop client JSON from Google Cloud Console)
# YOUTUBE_OAUTH_CLIENT_PATH=~/.config/google/youtube_oauth_client.json
# YOUTUBE_OAUTH_TOKEN_PATH=~/.config/google/youtube_token.json
# Optional: also ingest user playlists with this title prefix
# YOUTUBE_PLAYLIST_PREFIX=
